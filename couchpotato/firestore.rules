rules_version = '2';

// Database rules for the shared app. Paste into Firebase → Firestore →
// Rules and Publish. These rules ARE the wall between companies: the app
// asks for a company's records, and these decide whether the person asking
// may have them.
//
//   users/<uid>                    a login's pointer to its company (own doc only)
//   companies/<cid>                the company: name, owner, plan
//   companies/<cid>/members/<uid>  who is in the company, with their role
//   companies/<cid>/invites/<mail> + invites/<mail>   pending invitations
//   companies/<cid>/roles/<key>    the owner's roles: per screen none / view / edit
//   companies/<cid>/payments/<id>  PayFast payments (written by the billing function only)
//   companies/<cid>/<coll>/<id>    the company's records
//   admins/<uid>                   the seller's own logins (written by factory-admin.mjs, never the app)
//
// Paying: a company may add and change records while its trial runs, while
// it is paid up, or when given free access. Otherwise it can still READ
// everything (its data stays its own) but cannot change anything until it
// pays. TRIAL_DAYS here must match TRIAL_DAYS in js/config.js.
//
// Roles: the owner designs them in the app. A collection can be changed by
// anyone whose role has 'edit' on one of the screens listed for it below,
// the same table as WRITE_AREAS in js/permissions.js. Keep the two in step.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath(cid) { return /databases/$(database)/documents/companies/$(cid)/members/$(request.auth.uid); }
    function isMember(cid) { return signedIn() && exists(memberPath(cid)); }
    function role(cid) { return get(memberPath(cid)).data.role; }
    function isOwner(cid) { return isMember(cid) && role(cid) == 'owner'; }
    function rolePath(cid) { return /databases/$(database)/documents/companies/$(cid)/roles/$(role(cid)); }
    // this person's level on one screen: the owner has edit everywhere
    function level(cid, area) { return role(cid) == 'owner' ? 'edit' : get(rolePath(cid)).data.perms.get(area, 'none'); }
    function ed(cid, area) { return level(cid, area) == 'edit'; }
    function sees(cid, area) { return level(cid, area) in ['view', 'edit']; }
    function validRole(cid, r) { return r == 'owner' || exists(/databases/$(database)/documents/companies/$(cid)/roles/$(r)); }
    // an update that touches only these fields
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function orderEditor(cid) { return ed(cid, 'orders') || ed(cid, 'factory') || ed(cid, 'scan') || ed(cid, 'pos') || ed(cid, 'quotes') || ed(cid, 'invoices') || ed(cid, 'deliveries'); }
    function materialEditor(cid) { return ed(cid, 'costing') || ed(cid, 'stock') || ed(cid, 'orders') || ed(cid, 'factory') || ed(cid, 'scan'); }
    function founding(cid) {
      return signedIn() && !exists(/databases/$(database)/documents/companies/$(cid))
        && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == request.auth.uid;
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function companyActive(cid) {
      let c = get(/databases/$(database)/documents/companies/$(cid)).data;
      return c.status == 'free'
        || (c.status == 'trial' && request.time < c.get('trialEndsAt', c.createdAt + duration.value(14, 'd')))
        || (c.get('paidUntil', null) is timestamp && request.time < c.paidUntil);
    }

    // The seller's own logins. Nobody can make themselves one from the app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // A login's own pointer. It grants nothing: access comes from members.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Pending invitations, looked up by the invited person's email.
    match /invites/{email} {
      allow read: if signedIn() && (myEmail() == email || isOwner(resource.data.companyId));
      allow create, update: if isOwner(request.resource.data.companyId) && validRole(request.resource.data.companyId, request.resource.data.role)
                            && request.resource.data.email == email;
      allow delete: if signedIn() && (myEmail() == email || isOwner(resource.data.companyId));
    }

    match /companies/{cid} {
      allow read: if isMember(cid) || isAdmin();
      // Starting a company: you become its owner, on a trial, created now.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.plan == 'trial' && request.resource.data.status == 'trial'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'plan', 'status', 'createdAt']);
      // The owner may rename it, nothing else: plan, status and paid-until are
      // set by the billing function. The seller may extend a trial or give free access.
      allow update: if (isOwner(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trialEndsAt', 'adminNote']));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(cid);
        // Joining happens two ways only: founding the company (in the same
        // write as creating it), or accepting an invitation for your email.
        allow create: if signedIn() && request.auth.uid == uid && (
                        ( request.resource.data.role == 'owner'
                          && !exists(/databases/$(database)/documents/companies/$(cid))
                          && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == request.auth.uid )
                        || ( exists(/databases/$(database)/documents/invites/$(myEmail()))
                          && get(/databases/$(database)/documents/invites/$(myEmail())).data.companyId == cid
                          && get(/databases/$(database)/documents/invites/$(myEmail())).data.role == request.resource.data.role ) );
        // Only an owner changes roles, and never their own (so a company is never left without one).
        // Anyone may correct their own name, and nothing else of their record.
        allow update: if (isOwner(cid) && uid != request.auth.uid && validRole(cid, request.resource.data.role))
                      || (signedIn() && request.auth.uid == uid && onlyChanged(['name', 'updatedAt', 'updatedBy']));
        // An owner removes people; anyone may leave.
        allow delete: if isOwner(cid) && uid != request.auth.uid || (signedIn() && request.auth.uid == uid && role(cid) != 'owner');
      }

      match /invites/{email} {
        allow read: if isMember(cid);
        allow create, update: if isOwner(cid) && validRole(cid, request.resource.data.role);
        allow delete: if isOwner(cid) || (signedIn() && myEmail() == email);
      }

      // The roles: everyone in the company reads them (their menus come from
      // them); only the owner changes them. The founder writes the starting set.
      match /roles/{key} {
        allow read: if isMember(cid);
        allow write: if isOwner(cid) || founding(cid);
      }

      // Settings: the founder writes them when the company is created; after that the settings screen.
      match /settings/{id} {
        allow read: if isMember(cid);
        allow write: if (isMember(cid) && ed(cid, 'settings')) || founding(cid);
      }

      match /payments/{id} {
        allow read: if isOwner(cid) || isAdmin();
        allow write: if false;
      }

      // The company's records, one rule per collection. Reading money and
      // buying records needs the matching screen; everything else is readable
      // by every member (screens refer to each other). Changing needs edit on
      // one of the listed screens, and a running trial or paid subscription.
      match /orders/{id} {
        allow read: if isMember(cid);
        allow create, delete: if isMember(cid) && companyActive(cid) && orderEditor(cid);
        // the stock room (booking fabric in) and buying (ordering fabric for
        // an order) may only change where the order's fabric is
        allow update: if isMember(cid) && companyActive(cid) && (orderEditor(cid)
                      || ((ed(cid, 'storeroom') || ed(cid, 'stock')) && onlyChanged(['fabricStatus', 'fabricReceivedAt', 'fabricNote', 'fabricPo', 'updatedAt', 'updatedBy', 'events'])));
      }
      // Drivers carry the secret code in their private link (it works like a
      // key): only roles that may edit deliveries read them. The driver page itself goes through the
      // factory-driver function, which checks the code on the server.
      match /drivers/{id} {
        allow read: if isMember(cid) && ed(cid, 'deliveries');
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'deliveries');
      }
      match /deliveryNotes/{id} {
        allow read: if isMember(cid) && (sees(cid, 'deliveries') || sees(cid, 'orders'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'deliveries');
      }
      match /customers/{id} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'customers') || ed(cid, 'orders') || ed(cid, 'pos') || ed(cid, 'quotes'));
      }
      match /products/{id} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'costing') || ed(cid, 'pos'));
      }
      match /materials/{id} {
        allow read: if isMember(cid);
        allow create, delete: if isMember(cid) && companyActive(cid) && materialEditor(cid);
        // the stock room may only change the count on the shelf, never a price
        allow update: if isMember(cid) && companyActive(cid) && (materialEditor(cid)
                      || (ed(cid, 'storeroom') && onlyChanged(['onHand', 'countedAt', 'updatedAt', 'updatedBy'])));
      }
      // The movement trail: added to by anyone who moves stock, changed or
      // removed by nobody but the owner.
      match /stockMoves/{id} {
        allow read: if isMember(cid) && (sees(cid, 'stock') || sees(cid, 'storeroom'));
        allow create: if isMember(cid) && companyActive(cid) && (materialEditor(cid) || ed(cid, 'storeroom'));
        allow update, delete: if isOwner(cid);
      }
      match /purchaseOrders/{id} {
        allow read: if isMember(cid) && (sees(cid, 'stock') || sees(cid, 'storeroom'));
        allow create, delete: if isMember(cid) && companyActive(cid) && ed(cid, 'stock');
        // the stock room may only book a delivery in against it
        allow update: if isMember(cid) && companyActive(cid) && (ed(cid, 'stock')
                      || (ed(cid, 'storeroom') && onlyChanged(['lines', 'status', 'receivedAt', 'updatedAt', 'updatedBy', 'events'])
                          && request.resource.data.status in ['part', 'received'] && request.resource.data.lines.size() == resource.data.lines.size()));
      }
      match /storeStaff/{id} {
        allow read: if isMember(cid) && sees(cid, 'storeroom');
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'storeroom');
      }
      match /assets/{id} {
        allow read: if isMember(cid) && (sees(cid, 'storeroom') || sees(cid, 'stock'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'storeroom');
      }
      match /invoices/{id} {
        allow read: if isMember(cid) && (sees(cid, 'invoices') || sees(cid, 'pos') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'invoices') || ed(cid, 'pos'));
      }
      match /sales/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'pos');
      }
      match /quotes/{id} {
        allow read: if isMember(cid) && sees(cid, 'quotes');
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'quotes');
      }
      match /counters/{id} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'orders') || ed(cid, 'pos') || ed(cid, 'quotes') || ed(cid, 'invoices') || ed(cid, 'stock') || ed(cid, 'factory') || ed(cid, 'scan') || ed(cid, 'costing') || ed(cid, 'deliveries'));
      }
      // Pay: the staff list and the wage runs. Only the Wages area sees them.
      match /staff/{id} {
        allow read: if isMember(cid) && sees(cid, 'wages');
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'wages');
      }
      // The till's staff and their PINs (hashed): the till reads them to unlock;
      // only the owner, or whoever may change the business settings, sets them.
      // The till's cash-ups (one open register at a time): float, pay-ins and
      // pay-outs, the count at the close.
      match /tillShifts/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'pos');
      }
      // Gift cards sold at the till: the code, the amount and what is left on it.
      // The shop's stock at the till: deliveries booked in (GRVs), stock takes,
      // and what the till keeps about each shop product (quick key, cost).
      match /suppliers/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'stock') || sees(cid, 'storeroom'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'pos') || ed(cid, 'stock'));
      }
      match /shopPos/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'stock') || sees(cid, 'storeroom'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'pos') || ed(cid, 'stock') || ed(cid, 'storeroom'));
      }
      match /grvs/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'stock') || sees(cid, 'storeroom') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'pos') || ed(cid, 'stock') || ed(cid, 'storeroom'));
      }
      match /stockTakes/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'stock') || sees(cid, 'storeroom'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'pos') || ed(cid, 'stock') || ed(cid, 'storeroom'));
      }
      match /shopProducts/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'stock') || sees(cid, 'costing') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && (ed(cid, 'pos') || ed(cid, 'stock') || ed(cid, 'costing'));
      }
      match /giftCards/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'profit'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'pos');
      }
      match /tillStaff/{id} {
        allow read: if isMember(cid) && (sees(cid, 'pos') || sees(cid, 'settings'));
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'settings');
      }
      // the clock-in register: names and times only, no pay. The roster comes from Wages.
      match /attendance/{id} {
        allow read: if isMember(cid) && (sees(cid, 'factory') || sees(cid, 'wages'));
        allow write: if isMember(cid) && companyActive(cid)
                     && (id == 'roster' ? ed(cid, 'wages') : (ed(cid, 'factory') || ed(cid, 'wages')));
      }
      match /wageRuns/{id} {
        allow read: if isMember(cid) && sees(cid, 'wages');
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'wages');
      }
      // The online shop (Shopify). Its app keys are read and written only by the
      // server (netlify/functions/factory-shopify.mjs), never by the app; the
      // connection status is shown to the team but only the server writes it.
      match /secrets/{id} {
        allow read, write: if false;
      }
      match /integrations/{id} {
        allow read: if isMember(cid);
        allow write: if false;
      }
      match /shopifyOrders/{id} {
        allow read, write: if false;
      }
      match /shopifyPushes/{id} {
        allow read, write: if false;
      }
      match /xeroPushes/{id} {
        allow read, write: if false;
      }

      // Anything else a future version keeps: the settings screen decides.
      match /{coll}/{id} {
        allow read: if isMember(cid) && !(coll in ['members', 'invites', 'settings', 'payments', 'roles', 'orders', 'customers', 'products', 'materials', 'stockMoves', 'purchaseOrders', 'invoices', 'sales', 'quotes', 'counters', 'drivers', 'deliveryNotes', 'storeStaff', 'assets', 'secrets', 'integrations', 'shopifyOrders', 'shopifyPushes', 'xeroPushes', 'attendance', 'staff', 'wageRuns', 'tillStaff', 'tillShifts', 'giftCards', 'grvs', 'stockTakes', 'shopProducts', 'suppliers', 'shopPos']);
        allow write: if isMember(cid) && companyActive(cid) && ed(cid, 'settings')
                     && !(coll in ['members', 'invites', 'settings', 'payments', 'roles', 'orders', 'customers', 'products', 'materials', 'stockMoves', 'purchaseOrders', 'invoices', 'sales', 'quotes', 'counters', 'drivers', 'deliveryNotes', 'storeStaff', 'assets', 'secrets', 'integrations', 'shopifyOrders', 'shopifyPushes', 'xeroPushes', 'attendance', 'staff', 'wageRuns', 'tillStaff', 'tillShifts', 'giftCards', 'grvs', 'stockTakes', 'shopProducts', 'suppliers', 'shopPos']);
      }
    }

    // ======================================================================
    // Retail POS: pos/{gid}/...  (see pos/DATA-MODEL.md)
    //
    // One group per deployment, several legal entities inside it. A person's
    // reach is their users record: role (cashier < supervisor < manager <
    // owner), entityIds and storeIds. Finished documents (sales, credit notes,
    // payments, stock movements, shifts, ...) are written only by the server
    // functions, which check totals, VAT and the document number first; the
    // browser can read them and never write them.
    // ======================================================================
    // the business may still work: no record (the first shops), free, a trial not yet over, or paid up.
    // Once a trial or subscription has run out, the app can read but not write until the owner pays.
    function pActive(gid) {
      let g = /databases/$(database)/documents/posGroups/$(gid);
      return !exists(g) || pGroupOk(get(g).data);
    }
    function pGroupOk(d) {
      return d.status == 'free'
        || (d.status == 'trial' && d.trialEndsAt > request.time)
        || ((d.status == 'active' || d.status == 'cancelled') && d.paidUntil > request.time);
    }
    function pUserDoc(gid) { return get(/databases/$(database)/documents/pos/$(gid)/users/$(request.auth.uid)).data; }
    function pMember(gid) {
      return signedIn() && exists(/databases/$(database)/documents/pos/$(gid)/users/$(request.auth.uid)) && pUserDoc(gid).active == true;
    }
    function pRole(gid) { return pUserDoc(gid).role; }
    function pRank(r) { return r == 'owner' ? 4 : (r == 'manager' ? 3 : (r == 'supervisor' ? 2 : (r == 'cashier' ? 1 : 0))); }
    function pAtLeast(gid, r) { return pMember(gid) && pRank(pRole(gid)) >= pRank(r); }
    function pOwner(gid) { return pMember(gid) && pRole(gid) == 'owner'; }
    function pInEntity(gid, eid) { return pRole(gid) == 'owner' || eid in pUserDoc(gid).entityIds; }
    function pInStore(gid, sid) { return pRole(gid) == 'owner' || sid in pUserDoc(gid).storeIds; }
    // reads: a record of one of my entities; a record of one of my stores.
    // The owner is settled before resource.data is touched, so an owner's
    // unfiltered list works; everyone else's query must filter the fields.
    function pReadsEntity(gid) { return pMember(gid) && (pRole(gid) == 'owner' || resource.data.entityId in pUserDoc(gid).entityIds); }
    function pReadsStore(gid) {
      return pMember(gid) && (pRole(gid) == 'owner'
        || (resource.data.entityId in pUserDoc(gid).entityIds && resource.data.storeId in pUserDoc(gid).storeIds));
    }
    // writes: at least this role, into one of my entities
    function pWritesEntity(gid, r) { return pAtLeast(gid, r) && pInEntity(gid, request.resource.data.entityId); }
    // the five stamps every record carries (rule 6), on a browser create ...
    function pStamped() {
      let d = request.resource.data;
      return d.keys().hasAll(['entityId', 'storeId', 'createdBy', 'createdAt', 'deviceId'])
        && d.entityId is string && d.entityId != '' && d.storeId is string
        && d.createdBy == request.auth.uid && d.createdAt is string && d.deviceId is string;
    }
    // ... and unchanged on a browser update
    function pStampsKept() {
      let a = request.resource.data;
      let b = resource.data;
      return a.entityId == b.entityId && a.storeId == b.storeId && a.createdBy == b.createdBy && a.createdAt == b.createdAt && a.deviceId == b.deviceId;
    }
    // money is whole cents (rule 1): an int, or null where the model allows it
    function pCents(v) { return v == null || v is int; }
    // who may write a users record with these contents
    function pUserWrite(gid, d) {
      return d.role in ['cashier', 'supervisor', 'manager', 'owner'] && d.entityIds is list && d.storeIds is list && d.active is bool
        && (pOwner(gid)
            || (pAtLeast(gid, 'manager') && d.role in ['cashier', 'supervisor']
                && pUserDoc(gid).entityIds.hasAll(d.entityIds) && pUserDoc(gid).storeIds.hasAll(d.storeIds)));
    }

    // ---- Factory Manager POS: which business a login is in, and each business (its trial and subscription).
    // Written only by the server (pos-auth, pos-signup, pos-billing).
    match /posMembers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /posGroups/{gid} {
      allow read: if pMember(gid);
      allow write: if false;
    }

    match /pos/{gid} {
      allow read: if pMember(gid);
      allow write: if false;

      // ---- people -------------------------------------------------------
      match /users/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || pAtLeast(gid, 'manager'));
        allow create: if pActive(gid) && pStamped() && pUserWrite(gid, request.resource.data) && request.auth.uid != uid;
        // anyone may change their own name and default store, nothing else of their own record;
        // a manager may only touch cashiers and supervisors within their reach, before and after
        allow update: if pActive(gid) && pStampsKept() && (
                        (request.auth.uid == uid && pMember(gid)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'defaultStoreId', 'updatedAt', 'updatedBy']))
                        || (request.auth.uid != uid && pUserWrite(gid, request.resource.data) && pUserWrite(gid, resource.data)));
        allow delete: if false;
      }
      match /pinHashes/{uid} { allow read, write: if false; }
      match /devices/{id} {
        allow read: if pReadsStore(gid);
        allow write: if false;                     // enrolment is a server function
      }

      // ---- entities, stores, registers, settings --------------------------
      match /entities/{id} {
        allow read: if pReadsEntity(gid);
        allow create: if pActive(gid) && pOwner(gid) && pStamped() && request.resource.data.entityId == id && request.resource.data.storeId == '';
        allow update: if pActive(gid) && pOwner(gid) && pStampsKept();
        allow delete: if false;
      }
      match /stores/{id} {
        allow read: if pReadsStore(gid);
        allow create: if pActive(gid) && pOwner(gid) && pStamped() && request.resource.data.storeId == id;
        allow update: if pActive(gid) && pOwner(gid) && pStampsKept();
        allow delete: if false;
      }
      match /registers/{id} {
        allow read: if pReadsStore(gid);
        allow create: if pActive(gid) && pWritesEntity(gid, 'manager') && pStamped() && pInStore(gid, request.resource.data.storeId)
                      && request.resource.data.currentShiftId == '';
        // the open shift is the server's to move
        allow update: if pActive(gid) && pWritesEntity(gid, 'manager') && pStampsKept() && pInStore(gid, resource.data.storeId)
                      && request.resource.data.currentShiftId == resource.data.currentShiftId;
        allow delete: if false;
      }
      match /settings/{eid} {
        allow read: if pReadsEntity(gid);
        allow create: if pActive(gid) && pAtLeast(gid, 'manager') && pInEntity(gid, eid) && pStamped()
                      && request.resource.data.entityId == eid && request.resource.data.storeId == '';
        allow update: if pActive(gid) && pAtLeast(gid, 'manager') && pInEntity(gid, eid) && pStampsKept();
        allow delete: if false;
      }

      // ---- catalogue ------------------------------------------------------
      match /products/{id} {
        allow read: if pReadsEntity(gid);
        allow create: if pActive(gid) && pWritesEntity(gid, 'manager') && pStamped() && request.resource.data.storeId == ''
                      && request.resource.data.priceCents is int && request.resource.data.costCents is int;
        allow update: if pActive(gid) && pWritesEntity(gid, 'manager') && pStampsKept()
                      && request.resource.data.priceCents is int && request.resource.data.costCents is int;
        allow delete: if false;                    // archive instead
      }
      match /variants/{id} {
        allow read: if pReadsEntity(gid);
        allow create: if pActive(gid) && pWritesEntity(gid, 'manager') && pStamped() && request.resource.data.storeId == ''
                      && request.resource.data.productId is string && pCents(request.resource.data.priceCents) && pCents(request.resource.data.costCents);
        allow update: if pActive(gid) && pWritesEntity(gid, 'manager') && pStampsKept()
                      && request.resource.data.productId == resource.data.productId && pCents(request.resource.data.priceCents) && pCents(request.resource.data.costCents);
        allow delete: if false;
      }

      // ---- customers ------------------------------------------------------
      match /customers/{id} {
        allow read: if pReadsEntity(gid);
        // the server alone writes customers: the cell number is one profile per company, store credit,
        // the account, consent and points all move under its hand (pos-customer, pos-sale)
        allow write: if false;
      }
      match /customerPhones/{id} { allow read, write: if false; }
      match /loyaltyLedger/{id}  { allow read: if pReadsEntity(gid); allow write: if false; }
      match /xeroJournals/{id}   { allow read: if pReadsEntity(gid) && pAtLeast(gid, 'manager'); allow write: if false; }
      // Shopify: the keys never leave the server; orders, codes, the queue and the log are read-only here
      match /shopifySecrets/{id} { allow read, write: if false; }
      match /shopifyQueue/{id}   { allow read: if pReadsEntity(gid) && pAtLeast(gid, 'supervisor'); allow write: if false; }
      match /shopifySync/{id}    { allow read: if pReadsEntity(gid) && pAtLeast(gid, 'supervisor'); allow write: if false; }
      match /onlineOrders/{id}   { allow read: if pReadsStore(gid) && pAtLeast(gid, 'supervisor'); allow write: if false; }
      match /discountCodes/{id}  { allow read: if pReadsEntity(gid); allow write: if false; }

      // ---- buying ---------------------------------------------------------
      match /suppliers/{id} {
        allow read: if pReadsEntity(gid) && pAtLeast(gid, 'supervisor');
        allow create: if pActive(gid) && pWritesEntity(gid, 'manager') && pStamped() && request.resource.data.storeId == '';
        allow update: if pActive(gid) && pWritesEntity(gid, 'manager') && pStampsKept();
        allow delete: if false;
      }
      match /purchaseOrders/{id} {
        allow read: if pReadsStore(gid) && pAtLeast(gid, 'supervisor');
        // a draft is the manager's; sending it (the number) and receiving against it are the server's
        allow create: if pActive(gid) && pWritesEntity(gid, 'manager') && pStamped() && pInStore(gid, request.resource.data.storeId)
                      && request.resource.data.status == 'draft' && request.resource.data.get('docNo', '') == '';
        allow update: if pActive(gid) && pWritesEntity(gid, 'manager') && pStampsKept() && pInStore(gid, resource.data.storeId)
                      && resource.data.status == 'draft' && request.resource.data.status == 'draft'
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seq', 'docNo']);
        allow delete: if false;
      }

      // ---- finished documents and stock: the server's alone -----------------
      match /stockLevels/{id}    { allow read: if pReadsStore(gid); allow write: if false; }
      match /stockMovements/{id} { allow read: if pReadsStore(gid); allow write: if false; }
      match /sales/{id}          { allow read: if pReadsStore(gid); allow write: if false; }
      match /saleLines/{id}      { allow read: if pReadsStore(gid); allow write: if false; }
      match /payments/{id}       { allow read: if pReadsStore(gid); allow write: if false; }
      match /creditNotes/{id}    { allow read: if pReadsStore(gid); allow write: if false; }
      match /refunds/{id}        { allow read: if pReadsStore(gid); allow write: if false; }
      match /laybys/{id}         { allow read: if pReadsStore(gid); allow write: if false; }
      match /stockTakes/{id}     { allow read: if pReadsStore(gid); allow write: if false; }
      match /specialOrders/{id}  { allow read: if pReadsStore(gid); allow write: if false; }
      match /salesOrders/{id}    { allow read: if pReadsStore(gid); allow write: if false; }
      match /tasks/{id}          { allow read: if pReadsStore(gid); allow write: if false; }
      match /shifts/{id}         { allow read: if pReadsStore(gid); allow write: if false; }
      match /cashMovements/{id}  { allow read: if pReadsStore(gid); allow write: if false; }
      match /goodsReceived/{id}  { allow read: if pReadsStore(gid) && pAtLeast(gid, 'supervisor'); allow write: if false; }
      // a transfer is read at both ends
      match /transfers/{id}      { allow read: if pReadsEntity(gid) && pAtLeast(gid, 'supervisor') && (pInStore(gid, resource.data.fromStoreId) || pInStore(gid, resource.data.toStoreId)); allow write: if false; }
      match /numberBlocks/{id}   { allow read: if pReadsStore(gid); allow write: if false; }
      match /voidedNumbers/{id}  { allow read: if pReadsEntity(gid) && pAtLeast(gid, 'manager'); allow write: if false; }
      match /vouchers/{code}     { allow read: if pReadsEntity(gid); allow write: if false; }
      match /counters/{id}       { allow read, write: if false; }
      match /assistantUse/{uid}  { allow read, write: if false; }
      match /usedTokens/{id}     { allow read, write: if false; }
      match /assistantProposals/{id} { allow read, write: if false; }

      // ---- audit: anyone appends in their own name; nobody edits ------------
      match /auditLog/{id} {
        allow read: if pReadsEntity(gid) && pAtLeast(gid, 'manager');
        allow create: if pActive(gid) && pWritesEntity(gid, 'cashier') && pStamped() && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.action is string;
        allow update, delete: if false;
      }
    }

  }
}
